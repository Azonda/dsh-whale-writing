{
  "name": "dsh-whale-writing",
  "version": "0.1.2",
  "description": "DeepSeek Harness 插件：写作档位（T1–T4 风格 × L1–L5 严谨）、项目记忆（.mem 三区 + 守卫）、去 AI 味后处理（whale_polish）——双半体（host 工具/注入 + 浏览器快捷条/工具卡）。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azonda/dsh-whale-writing.git"
  },
  "homepage": "https://github.com/Azonda/dsh-whale-writing#readme",
  "bugs": {
    "url": "https://github.com/Azonda/dsh-whale-writing/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "writing",
    "whale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/guard-publish.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
